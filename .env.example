# Live microphone -> provided Russian/Kazakh RUKK model on CPU -> DeepSeek.
# Set DEEPSEEK_API_KEY before starting the consultation.
# Keep cloud credentials in provider-specific variables when switching servers.
# Place model.pt and tokens.lst in external_artifacts/ before starting.
# No NVIDIA GPU is needed for this default profile.
COMPOSE_PROFILES=local-asr-rukk
ASR_PROVIDER=openai-compatible
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
# Empty URL/model use the selected provider's defaults:
# deepseek -> https://api.deepseek.com + deepseek-flash
# openai -> OPENAI_BASE_URL + OPENAI_MODEL
LLM_BASE_URL=
LLM_MODEL=
# Optional key for a custom endpoint; takes precedence over provider-specific keys.
LLM_API_KEY=
# DeepSeek/compatible default json_object; strict compatible servers may json_schema.
LLM_RESPONSE_FORMAT=

# OpenAI-compatible ASR: multipart POST {ASR_BASE_URL}/audio/transcriptions
# RUKK is available here inside Docker, or localhost:8003 on the host.
# Warmup: POST http://localhost:8003/v1/models/load (loads local files, no download).
# Compose mounts external_artifacts/ read-only at /models/rukk.
ASR_BASE_URL=http://rukk:8000/v1
ASR_MODEL=asr-default
# RUKK uses a shared Russian/Kazakh vocabulary; it does not force a language.
ASR_LANGUAGE=auto
ASR_API_KEY=
ASR_CHUNK_SECONDS=5
RUKK_CPU_THREADS=6

# NVIDIA GPU alternative: COMPOSE_PROFILES=local-asr-gpu and
# ASR_BASE_URL=http://gigaam:8000/v1; keep ASR_MODEL=asr-default, ASR_LANGUAGE=auto.
# Requires NVIDIA access from Docker (Windows: Docker Desktop with WSL 2).
# GigaAM warmup: POST http://localhost:8002/v1/models/load; first download ~2.34 GB.
# Whisper CPU fallback: replace COMPOSE_PROFILES with local-asr, ASR_BASE_URL with
# http://transcriber:8000/v1, ASR_MODEL with whisper-1, ASR_LANGUAGE with ru/kk/auto.
# CPU warmup: POST http://localhost:8001/v1/models/load.
# External ASR: set its URL/model/key and clear the local ASR profile.

# Speechmatics is a separate true-streaming WSS adapter (Russian supported).
SPEECHMATICS_API_KEY=
SPEECHMATICS_URL=wss://eu.rt.speechmatics.com/v2/
SPEECHMATICS_LANGUAGE=ru

# Optional OpenAI Responses adapter; unrelated providers do not inherit this key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional CPU/int8 Whisper fallback; these options do not configure RUKK/GigaAM.
# Download happens on explicit warmup or first transcription, not at Docker build.
WHISPER_MODEL=small
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1

# For slow local models, increase up to 300 seconds and warm them up first.
PROVIDER_TIMEOUT_SECONDS=60
MAX_CONTEXT_CHARACTERS=80000
ALLOW_INSECURE_HTTP=false
# Legacy fallback only when ASR_PROVIDER / LLM_PROVIDER are absent.
APP_MODE=live
